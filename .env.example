# Firebase Admin service account. Keep server-side only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Simple admin login (NOT Firebase Authentication)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-long-password
ADMIN_SESSION_SECRET=change-this-to-a-random-32-plus-character-secret

# Optional store settings
NEXT_PUBLIC_STORE_NAME=Smark Mart
